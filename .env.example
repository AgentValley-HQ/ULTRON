PORT=5173

# ================================================================
# 1. ROUTING / GUARDRAILS — TypeSafe Jev
# ================================================================
# Leave blank to run with the fallback regex router.
# Get a key at https://console.typesafe.ai/
TYPESAFE_API_KEY=


# ================================================================
# 2. REASONING LAYER — choose one of (a), (b), or (c)
# ================================================================
# Priority order below: ANTHROPIC_API_KEY → OPENAI_API_KEY → mock.

# (a) Anthropic Claude — full connector + tool support (Gmail, Calendar, Notion, ...).
#     Either set a direct API key here, or leave blank and run `claude /login`
#     once in a terminal; Ultron auto-detects the credential file.
ANTHROPIC_API_KEY=

# (b) OpenAI — text-only fallback. NO connectors, NO tool use.
#     Answers general questions, cannot send email / book meetings / etc.
#     Model defaults:
#       haiku  tier  →  gpt-4o-mini
#       sonnet tier  →  gpt-4o-mini
#       opus   tier  →  gpt-4o
#     Override any tier with the vars below.
OPENAI_API_KEY=
# OPENAI_MODEL_FAST=gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL_SMART=gpt-4o


# ================================================================
# 3. VOICE — choose one of (a), (b), or (c)
# ================================================================
# Priority order: ELEVENLABS_API_KEY → SONIOX_API_KEY → browser Web Speech API.

# (a) ElevenLabs — premium voices. Get a key at https://elevenlabs.io
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB   # Adam (deep male, default)
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# ELEVENLABS_SAMPLE_RATE=24000               # 24000 needs paid tier; use 22050 or 16000 on free

# (b) Soniox — streaming STT + TTS. Get a key at https://console.soniox.com
SONIOX_API_KEY=
# SONIOX_VOICE=Adrian
# SONIOX_LANG=en

# (c) Both blank → the browser's built-in Web Speech API handles STT and TTS.
#     Works but quality is uneven and voices are robotic.
